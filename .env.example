# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/barangay_reliefops
DB_HOST=localhost
DB_PORT=5432
DB_NAME=barangay_reliefops
DB_USER=postgres
DB_PASSWORD=password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=8h

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
# Optional public Socket.IO origin for a separately hosted frontend; defaults to the current origin.
VITE_SOCKET_URL=

# Cooldown period in hours for household claims
CLAIM_COOLDOWN_HOURS=24

# Low stock threshold percentage
LOW_STOCK_THRESHOLD=20
